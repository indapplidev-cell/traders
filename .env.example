# Core service metadata (optional; defaults are shown)
SERVICE_NAME=traders-ml
SERVICE_VERSION=0.2.0
APP_ENV=dev

# PostgreSQL container settings used by docker-compose.yml (required for Compose)
POSTGRES_USER=traders_ml
POSTGRES_PASSWORD=change_me
POSTGRES_DB=traders_ml

# Host-side application URL; Compose publishes PostgreSQL on localhost:5433.
DATABASE_URL=

# Optional engine-specific override. Leave empty to use DATABASE_URL.
MARKET_DATA_DATABASE_URL=

# Optional DB preview aliases accepted by app.engine_analysis.db_cli_preview.
TRADERS_ML_DATABASE_URL=
TRADERS_ML_POSTGRES_URL=
POSTGRES_URL=

# Optional test/integration gates; disabled by default.
TEST_POSTGRES_DATABASE_URL=
RUN_ENGINE_MARKET_DATA_04_PROD_SMOKE=0

# Durable online-orchestrator freshness retry policy.
ORCHESTRATOR_FRESHNESS_RETRY_INTERVAL_SECONDS=5
ORCHESTRATOR_FRESHNESS_GRACE_SECONDS=180
ORCHESTRATOR_FRESHNESS_MAX_ATTEMPTS=60
ORCHESTRATOR_WAITING_BATCH_SIZE=100

# Public Binance market-data access does not require private API credentials.
