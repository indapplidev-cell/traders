# Copy this template to a task-owned path outside Git and replace placeholders there.
# DO NOT USE DATABASE OWNER/ADMIN CREDENTIALS.
# The database identity must be a dedicated PostgreSQL role with CONNECT and SELECT
# only, default_transaction_read_only=on, and no DDL or DML privileges.
TRADERS_READONLY_API_DATABASE_URL=postgresql+psycopg://<READONLY_ROLE>:<READONLY_PASSWORD>@<DATABASE_HOST>:5432/<DATABASE_NAME>
TRADERS_READONLY_API_HOST=0.0.0.0
TRADERS_READONLY_API_PORT=8080
TRADERS_READONLY_API_LOG_LEVEL=info
TRADERS_READONLY_API_STATEMENT_TIMEOUT_MS=30000
TRADERS_READONLY_API_POOL_SIZE=5
TRADERS_READONLY_API_POOL_TIMEOUT_SECONDS=30
