{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traders-ml:engine-trend-22:setup-plan-input",
  "title": "ENGINE-TREND-22 Setup Plan Input",
  "description": "Audit-only input. The plan and all levels must have been fixed causally before future candles are supplied.",
  "type": "object",
  "required": ["symbol", "timeframe", "setup_type", "status", "direction", "entry", "stop", "targets", "expires_after_candles"],
  "anyOf": [{"required": ["case_id"]}, {"required": ["setup_id"]}],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "setup_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "timeframe": {"type": "string", "minLength": 1},
    "setup_type": {
      "enum": [
        "SHORT_DOWN_CONTINUATION_RETEST",
        "SHORT_TREND_ONLY_CONTINUATION_CANDIDATE",
        "LONG_UP_CONTINUATION_RETEST",
        "RANGE_MEAN_REVERSION_CANDIDATE",
        "NO_TRADE_CONTRACT"
      ]
    },
    "status": {"enum": ["TRADE_CANDIDATE", "WAIT_CONFIRMATION", "NO_TRADE", "INVALIDATED"]},
    "direction": {"enum": ["LONG", "SHORT", "NONE"]},
    "entry": {
      "type": "object",
      "required": ["type", "price"],
      "properties": {
        "type": {"enum": ["confirmation_close", "limit_retest", "breakout_stop", "none"]},
        "price": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "timestamp": {"type": ["string", "null"], "format": "date-time"},
        "confirmation_candle_time": {"type": ["string", "null"], "format": "date-time"}
      },
      "anyOf": [{"required": ["timestamp"]}, {"required": ["confirmation_candle_time"]}],
      "additionalProperties": true
    },
    "stop": {
      "type": "object",
      "required": ["price"],
      "properties": {"price": {"type": ["number", "null"], "exclusiveMinimum": 0}},
      "additionalProperties": true
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["price"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "price": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "rr": {"type": ["number", "null"], "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "expires_after_candles": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "TRADE_CANDIDATE"}}, "required": ["status"]},
      "then": {
        "properties": {
          "direction": {"enum": ["LONG", "SHORT"]},
          "entry": {"properties": {"price": {"type": "number"}}},
          "stop": {"properties": {"price": {"type": "number"}}},
          "targets": {"minItems": 1}
        }
      }
    }
  ]
}
