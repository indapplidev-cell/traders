{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traders-ml:engine-trend-22:profitability-label",
  "title": "ENGINE-TREND-22 Profitability Label",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "label_status", "direction", "entry_time", "entry_price",
    "stop_price", "target_price", "exit_time", "exit_price", "exit_reason", "risk_abs",
    "reward_abs", "realized_return_abs", "rr_planned", "mfe_abs", "mfe_pct", "mfe_r",
    "mae_abs", "mae_pct", "mae_r", "bars_to_outcome", "bars_to_tp", "bars_to_sl",
    "bars_to_max_favorable", "bars_to_max_adverse", "bars_to_expiry", "gross_return_pct",
    "fee_bps_per_side", "slippage_bps_per_side", "round_trip_cost_bps", "net_return_pct",
    "ambiguity_flags", "validation_errors", "data_quality", "target_results", "audit_only"
  ],
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 1},
    "status": {"enum": ["TP_BEFORE_SL", "SL_BEFORE_TP", "NEITHER_EXPIRED", "AMBIGUOUS_INTRACANDLE", "INSUFFICIENT_FUTURE_DATA", "INVALID_SETUP_PLAN", "NO_TRADE_SKIPPED"]},
    "targetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "label_status", "target_price", "exit_time", "exit_price", "exit_reason", "risk_abs", "reward_abs", "realized_return_abs", "rr_planned", "mfe_abs", "mfe_pct", "mfe_r", "mae_abs", "mae_pct", "mae_r", "bars_to_outcome", "bars_to_tp", "bars_to_sl", "bars_to_max_favorable", "bars_to_max_adverse", "bars_to_expiry", "gross_return_pct", "net_return_pct", "ambiguity_flags", "data_quality"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "label_status": {"$ref": "#/$defs/status"},
        "target_price": {"type": "number", "exclusiveMinimum": 0},
        "exit_time": {"type": ["string", "null"], "format": "date-time"},
        "exit_price": {"$ref": "#/$defs/nullableNumber"},
        "exit_reason": {"enum": ["TARGET", "STOP", "EXPIRY", "NONE"]},
        "risk_abs": {"type": "number", "exclusiveMinimum": 0},
        "reward_abs": {"type": "number", "exclusiveMinimum": 0},
        "realized_return_abs": {"$ref": "#/$defs/nullableNumber"},
        "rr_planned": {"type": "number", "exclusiveMinimum": 0},
        "mfe_abs": {"$ref": "#/$defs/nullableNumber"}, "mfe_pct": {"$ref": "#/$defs/nullableNumber"}, "mfe_r": {"$ref": "#/$defs/nullableNumber"},
        "mae_abs": {"$ref": "#/$defs/nullableNumber"}, "mae_pct": {"$ref": "#/$defs/nullableNumber"}, "mae_r": {"$ref": "#/$defs/nullableNumber"},
        "bars_to_outcome": {"$ref": "#/$defs/nullableInteger"}, "bars_to_tp": {"$ref": "#/$defs/nullableInteger"}, "bars_to_sl": {"$ref": "#/$defs/nullableInteger"},
        "bars_to_max_favorable": {"$ref": "#/$defs/nullableInteger"}, "bars_to_max_adverse": {"$ref": "#/$defs/nullableInteger"}, "bars_to_expiry": {"$ref": "#/$defs/nullableInteger"},
        "gross_return_pct": {"$ref": "#/$defs/nullableNumber"}, "net_return_pct": {"$ref": "#/$defs/nullableNumber"},
        "ambiguity_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "data_quality": {"enum": ["PASS", "AMBIGUOUS", "INCOMPLETE"]}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0-audit"}, "case_id": {"type": "string", "minLength": 1}, "label_status": {"$ref": "#/$defs/status"},
    "direction": {"enum": ["LONG", "SHORT", "NONE"]}, "entry_time": {"type": ["string", "null"], "format": "date-time"},
    "entry_price": {"$ref": "#/$defs/nullableNumber"}, "stop_price": {"$ref": "#/$defs/nullableNumber"}, "target_price": {"$ref": "#/$defs/nullableNumber"},
    "exit_time": {"type": ["string", "null"], "format": "date-time"}, "exit_price": {"$ref": "#/$defs/nullableNumber"},
    "exit_reason": {"enum": ["TARGET", "STOP", "EXPIRY", "NONE", "NOT_A_TRADE"]},
    "risk_abs": {"$ref": "#/$defs/nullableNumber"}, "reward_abs": {"$ref": "#/$defs/nullableNumber"}, "realized_return_abs": {"$ref": "#/$defs/nullableNumber"},
    "rr_planned": {"$ref": "#/$defs/nullableNumber"}, "mfe_abs": {"$ref": "#/$defs/nullableNumber"}, "mfe_pct": {"$ref": "#/$defs/nullableNumber"}, "mfe_r": {"$ref": "#/$defs/nullableNumber"},
    "mae_abs": {"$ref": "#/$defs/nullableNumber"}, "mae_pct": {"$ref": "#/$defs/nullableNumber"}, "mae_r": {"$ref": "#/$defs/nullableNumber"},
    "bars_to_outcome": {"$ref": "#/$defs/nullableInteger"}, "bars_to_tp": {"$ref": "#/$defs/nullableInteger"}, "bars_to_sl": {"$ref": "#/$defs/nullableInteger"},
    "bars_to_max_favorable": {"$ref": "#/$defs/nullableInteger"}, "bars_to_max_adverse": {"$ref": "#/$defs/nullableInteger"}, "bars_to_expiry": {"$ref": "#/$defs/nullableInteger"},
    "gross_return_pct": {"$ref": "#/$defs/nullableNumber"}, "fee_bps_per_side": {"type": "number", "minimum": 0}, "slippage_bps_per_side": {"type": "number", "minimum": 0},
    "round_trip_cost_bps": {"type": "number", "minimum": 0}, "net_return_pct": {"$ref": "#/$defs/nullableNumber"},
    "ambiguity_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "validation_errors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "data_quality": {"enum": ["PASS", "AMBIGUOUS", "INCOMPLETE", "FAIL", "NOT_APPLICABLE"]},
    "target_results": {"type": "array", "items": {"$ref": "#/$defs/targetResult"}}, "audit_only": {"const": true}
  }
}
