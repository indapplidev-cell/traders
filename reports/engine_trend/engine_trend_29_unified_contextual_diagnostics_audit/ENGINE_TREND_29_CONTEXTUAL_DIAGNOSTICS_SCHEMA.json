{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine_trend_29_contextual_diagnostics_v2",
  "title": "ENGINE-TREND-29 offline contextual diagnostics",
  "description": "A partial-data-safe, non-actionable schema for diagnostics attached after the final composer decision.",
  "type": "object",
  "required": [
    "diagnostic_version",
    "generated_for_stage",
    "observed_tags",
    "no_action_reasons",
    "wait_for_confirmation_reasons",
    "explanation_tags",
    "observability",
    "not_observable_fields",
    "source_fields_used",
    "decision_impact",
    "safety_guarantees"
  ],
  "properties": {
    "diagnostic_version": {"const": "2.0.0"},
    "generated_for_stage": {"const": "ENGINE-TREND-29"},
    "source_regime": {"enum": ["UP", "DOWN", "FLAT", "UNKNOWN"]},
    "action": {"const": "NO_ACTION"},
    "contextual_state": {"enum": ["WAIT_FOR_CONFIRMATION", "CONTEXT_ONLY"]},
    "observed_tags": {"$ref": "#/$defs/stringSet"},
    "diagnostic_tags": {"$ref": "#/$defs/stringSet"},
    "no_action_reasons": {"$ref": "#/$defs/stringSet"},
    "wait_for_confirmation_reasons": {"$ref": "#/$defs/stringSet"},
    "explanation_tags": {"$ref": "#/$defs/stringSet"},
    "observability": {
      "type": "object",
      "additionalProperties": {"enum": ["observable", "not_observable"]}
    },
    "not_observable_fields": {"$ref": "#/$defs/stringSet"},
    "source_fields_used": {"$ref": "#/$defs/stringSet"},
    "decision_impact": {
      "type": "object",
      "required": [
        "source_regime",
        "final_regime",
        "setup_eligibility",
        "trade_decision",
        "risk_reduced_by_missing_data",
        "confirmation_created_by_missing_data"
      ],
      "properties": {
        "source_regime": {"const": "unchanged"},
        "final_regime": {"const": "unchanged"},
        "setup_eligibility": {"const": "unchanged"},
        "trade_decision": {"const": "unchanged"},
        "risk_reduced_by_missing_data": {"const": false},
        "confirmation_created_by_missing_data": {"const": false}
      }
    },
    "safety_guarantees": {
      "type": "object",
      "required": [
        "post_decision_only",
        "offline_outputs_only",
        "missing_data_is_not_observable",
        "diagnostic_tags_are_non_actionable"
      ],
      "properties": {
        "post_decision_only": {"const": true},
        "offline_outputs_only": {"const": true},
        "missing_data_is_not_observable": {"const": true},
        "diagnostic_tags_are_non_actionable": {"const": true}
      }
    }
  },
  "$defs": {
    "diagnosticState": {
      "description": "Five distinct semantic states; not_observable must never be collapsed into false.",
      "enum": ["false", "true", "unknown", "not_observable", "not_applicable"]
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}
