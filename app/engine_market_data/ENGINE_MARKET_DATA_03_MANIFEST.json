{
  "module": "engine_market_data",
  "stage": "ENGINE-MARKET-DATA-03",
  "purpose": "historical backfill to current closed UTC candle",
  "database": "postgresql",
  "orm": "sqlalchemy",
  "migrations": "alembic",
  "utc_only": true,
  "closed_candle_only": true,
  "rolling_window_limits": {
    "1m": 10000,
    "5m": 10000,
    "15m": 10000,
    "1h": 5000,
    "4h": 3000,
    "1d": 1500
  },
  "downloads_only_missing_candles": true,
  "restart_safe": true,
  "idempotent_upsert": true,
  "creates_synthetic_candles": false,
  "future_bars_used": false,
  "uses_public_market_data_only": true,
  "uses_private_api": false,
  "uses_api_keys": false,
  "imports_engine_analysis": false,
  "imports_engine_setup": false,
  "imports_engine_strategy": false,
  "imports_engine_risk": false,
  "imports_engine_execution": false,
  "imports_engine_position": false,
  "imports_engine_exit": false,
  "creates_setup_candidates": false,
  "creates_trade_signals": false,
  "places_orders": false,
  "calculates_pnl": false
}
